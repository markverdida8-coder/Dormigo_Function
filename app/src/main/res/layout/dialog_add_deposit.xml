<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/dialogDepositTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Required Deposit"
        android:textColor="#1A1A1A"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Deposit Name Dropdown -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Deposit Name"
        android:textColor="#6E6E73"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerDepositName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:paddingHorizontal="12dp" />

    <!-- Custom Deposit Name Input -->
    <EditText
        android:id="@+id/inputCustomDepositName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_input_field"
        android:hint="Custom Deposit Name"
        android:inputType="textCapWords"
        android:paddingHorizontal="14dp"
        android:textColor="#1A1A1A"
        android:textColorHint="#9A9A9E"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- Amount (₱) Input -->
    <TextView
        android:id="@+id/depositValueLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Amount (₱)"
        android:textColor="#6E6E73"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/inputDepositValue"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:hint="0.00"
        android:inputType="numberDecimal"
        android:paddingHorizontal="14dp"
        android:textColor="#1A1A1A"
        android:textColorHint="#9A9A9E"
        android:textSize="14sp" />

    <!-- Payment Details / Description -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Payment Details (Optional)"
        android:textColor="#6E6E73"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/inputDepositDescription"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:hint="e.g. Refundable after move-out"
        android:inputType="text"
        android:paddingHorizontal="14dp"
        android:textColor="#1A1A1A"
        android:textColorHint="#9A9A9E"
        android:textSize="14sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelDeposit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:text="Cancel"
            android:textColor="#6E6E73"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSaveDeposit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_button_filled"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="24dp"
            android:paddingVertical="10dp"
            android:text="Save Deposit"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
