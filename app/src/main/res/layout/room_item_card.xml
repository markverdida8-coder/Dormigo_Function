<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_input_field"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header & Remove Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textRoomTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Room 1"
            android:textColor="#1A1A1A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnRemoveRoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:padding="4dp"
            android:text="Remove"
            android:textColor="#D32F2F"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Room Type -->
    <AutoCompleteTextView
        android:id="@+id/inputRoomType"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_field"
        android:clickable="true"
        android:focusable="false"
        android:hint="Room type"
        android:inputType="none"
        android:paddingHorizontal="14dp"
        android:textColor="#1A1A1A"
        android:textColorHint="#9A9A9E"
        android:textSize="14sp" />

    <!-- Name & Monthly Rent -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/inputRoomName"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:hint="Room name / number"
            android:inputType="text"
            android:paddingHorizontal="14dp"
            android:textColor="#1A1A1A"
            android:textColorHint="#9A9A9E"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/inputRoomRent"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:hint="Rent / month (₱)"
            android:inputType="numberDecimal"
            android:paddingHorizontal="14dp"
            android:textColor="#1A1A1A"
            android:textColorHint="#9A9A9E"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Capacity -->
    <EditText
        android:id="@+id/inputRoomCapacity"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_field"
        android:hint="Capacity (number of people)"
        android:inputType="number"
        android:paddingHorizontal="14dp"
        android:textColor="#1A1A1A"
        android:textColorHint="#9A9A9E"
        android:textSize="14sp" />

    <!-- Additional Fees Section -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Additional Fees"
            android:textColor="#1A1A1A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAddRoomFee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackground"
            android:padding="4dp"
            android:text="+ Add Fee"
            android:textColor="#1B5E4C"
            android:textSize="13sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/roomFeesContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />

    <!-- Refund Policy -->
    <EditText
        android:id="@+id/inputRefundPolicy"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_field"
        android:gravity="top|start"
        android:hint="Deposit refund policy &amp; conditions"
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:textColor="#1A1A1A"
        android:textColorHint="#9A9A9E"
        android:textSize="13sp" />

    <!-- Calculated Total Initial Payment -->
    <TextView
        android:id="@+id/textCalculatedTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Total Move-in Payment: ₱0.00"
        android:textColor="#1B5E4C"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
