<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_input_field"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header & Remove Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textRoomTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Room 1"
            android:textColor="#1A1A1A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnRemoveRoom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:padding="4dp"
            android:text="Remove"
            android:textColor="#D32F2F"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Room Type -->
    <AutoCompleteTextView
        android:id="@+id/inputRoomType"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_field"
        android:clickable="true"
        android:focusable="false"
        android:hint="Room type"
        android:inputType="none"
        android:paddingHorizontal="14dp"
        android:textColor="#1A1A1A"
        android:textColorHint="#9A9A9E"
        android:textSize="14sp" />

    <!-- Name & Monthly Rent -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/inputRoomName"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:hint="Room name / number"
            android:inputType="text"
            android:paddingHorizontal="14dp"
            android:textColor="#1A1A1A"
            android:textColorHint="#9A9A9E"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/inputRoomRent"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:hint="Rent / month (₱)"
            android:inputType="numberDecimal"
            android:paddingHorizontal="14dp"
            android:textColor="#1A1A1A"
            android:textColorHint="#9A9A9E"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Capacity -->
    <EditText
        android:id="@+id/inputRoomCapacity"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_field"
        android:hint="Capacity (number of people)"
        android:inputType="number"
        android:paddingHorizontal="14dp"
        android:textColor="#1A1A1A"
        android:textColorHint="#9A9A9E"
        android:textSize="14sp" />

    <!-- Advance Payment & Security Deposit -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Advance Payment"
                android:textColor="#6E6E73"
                android:textSize="12sp" />

            <AutoCompleteTextView
                android:id="@+id/inputAdvance"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:clickable="true"
                android:focusable="false"
                android:inputType="none"
                android:paddingHorizontal="10dp"
                android:textColor="#1A1A1A"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Security Deposit"
                android:textColor="#6E6E73"
                android:textSize="12sp" />

            <AutoCompleteTextView
                android:id="@+id/inputDeposit"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input_field"
                android:clickable="true"
                android:focusable="false"
                android:inputType="none"
                android:paddingHorizontal="10dp"
                android:textColor="#1A1A1A"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Checkbox for Additional Move-in Fees -->
    <CheckBox
        android:id="@+id/checkboxOtherFees"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="This room has additional move-in fees"
        android:textColor="#1A1A1A"
        android:textSize="13sp" />

    <!-- Other Fees & Description Container (Hidden by default) -->
    <LinearLayout
        android:id="@+id/layoutOtherFeesContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <EditText
            android:id="@+id/inputOtherFees"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:hint="Other Fees (₱0)"
            android:inputType="numberDecimal"
            android:paddingHorizontal="14dp"
            android:textColor="#1A1A1A"
            android:textColorHint="#9A9A9E"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/inputOtherFeesDesc"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:hint="Fee description"
            android:inputType="text"
            android:paddingHorizontal="14dp"
            android:textColor="#1A1A1A"
            android:textColorHint="#9A9A9E"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Refund Policy -->
    <EditText
        android:id="@+id/inputRefundPolicy"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_field"
        android:gravity="top|start"
        android:hint="Deposit refund policy &amp; conditions"
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:textColor="#1A1A1A"
        android:textColorHint="#9A9A9E"
        android:textSize="13sp" />

    <!-- Calculated Total Initial Payment -->
    <TextView
        android:id="@+id/textCalculatedTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Total Move-in Payment: ₱0.00"
        android:textColor="#1B5E4C"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
